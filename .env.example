# Copy to .env.local for local development, and add the same two values in
# Vercel / Cloudflare Pages → Settings → Environment variables.
# Supabase → Project Settings → API. Both are safe to publish (RLS protects the data).
# Leave them empty to run the offline demo with generated data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
