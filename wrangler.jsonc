{
  // Cloudflare Workers Static Assets — how the POS is served in production.
  //
  // The POS is a static Vite bundle with client-side routing, so there is no
  // Worker script: Cloudflare serves ./dist directly from its edge.
  //
  // `not_found_handling: single-page-application` is the important line. Deep
  // links like /appointments or /login?reset=1 are real URLs to the browser but
  // not real files on disk; without it the edge would 404 them instead of
  // handing the request to index.html for the router to resolve.
  //
  // Do NOT add a public/_redirects file containing `/* /index.html 200`. That
  // rule is correct on Pages and Netlify, but Workers Static Assets parses the
  // same file and rejects it outright:
  //     Invalid _redirects configuration: Line 1: Infinite loop detected
  // The deploy fails after a successful build, which is a confusing place to
  // land. SPA routing here is this setting's job; Vercel's is in vercel.json.
  //
  // Build settings in the Cloudflare dashboard:
  //   Build command   npm run build
  //   Deploy command  npx wrangler deploy
  //
  // The two VITE_SUPABASE_* variables must be set in the dashboard BEFORE the
  // first build — Vite compiles them into the bundle, so a build without them
  // produces a POS permanently stuck in demo mode. They are public by design;
  // the service_role key must never be among them.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aura-by-hs-pos-system",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
